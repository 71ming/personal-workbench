# 数据库文件（含全部笔记数据，不进版本库）
data/

# Rust / Tauri 构建产物。
# target/ 是 cargo 的编译缓存，单个工程能到几个 GB，绝对不能进版本库。
desktop/src-tauri/target/
desktop/src-tauri/gen/

# 打好的安装包（每个 2MB 左右，二进制）。
# 放在仓库外是为了清target 缓存时不把它一起清掉；
# 但它也不该进 git 历史 —— 发布走 GitHub Releases 的附件，不靠版本库。
desktop/release/*.exe

# 更新清单同理：它每次发版都会变，是**产物**不是源码。
# 它的内容由 tools/make-latest-json.js 生成。
desktop/release/latest.json

# 编译/测试的输出日志。我习惯 `cargo build 2>&1 | Out-File err.txt`，
# 不小心就 git add . 进去了 —— 它每次都不一样，会把历史冲得很难看。
build-err.txt
test-out.txt
*.bak

# 系统与编辑器杂项
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
